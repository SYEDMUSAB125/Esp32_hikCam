// Camera Digest authentication: implemented here because some prebuilt
// ESP-IDF/Arduino cores disable automatic HTTP Digest authentication.
// HTTPS Firebase requests still use WiFiClientSecure separately.
String md5Hex(const String& value) {
  unsigned char digest[16];
#if MBEDTLS_VERSION_MAJOR >= 3
  if (mbedtls_md5((const unsigned char*)value.c_str(), value.length(), digest) != 0) return "";
#else
  if (mbedtls_md5_ret((const unsigned char*)value.c_str(), value.length(), digest) != 0) return "";
#endif
  char out[33];
  for (int i = 0; i < 16; ++i) sprintf(out + (i * 2), "%02x", digest[i]);
  out[32] = '\0';
  return String(out);
}

// Extract realm, nonce, qop or algorithm from WWW-Authenticate.
// Supports quoted/unquoted attributes and commas inside quoted values.
String digestField(const String& challenge, const char* field) {
  String target = String(field);
  size_t i = 0;
  while (i < challenge.length()) {
    while (i < challenge.length() &&
           (challenge[i] == ' ' || challenge[i] == ',' || challenge[i] == '\t')) ++i;
    size_t start = i;
    while (i < challenge.length() &&
           challenge[i] != '=' && challenge[i] != ',' && challenge[i] != ' ') ++i;
    String key = challenge.substring(start, i);
    key.trim();
    while (i < challenge.length() && challenge[i] == ' ') ++i;
    if (i >= challenge.length() || challenge[i] != '=') {
      while (i < challenge.length() && challenge[i] != ',') ++i;
      continue;
    }
    ++i;
    while (i < challenge.length() && challenge[i] == ' ') ++i;
    String val;
    if (i < challenge.length() && challenge[i] == '"') {
      ++i;
      while (i < challenge.length()) {
        if (challenge[i] == '"') { ++i; break; }
        if (challenge[i] == '\\' && i + 1 < challenge.length()) ++i;
        val += challenge[i++];
      }
    } else {
      size_t v = i;
      while (i < challenge.length() && challenge[i] != ',') ++i;
      val = challenge.substring(v, i);
      val.trim();
    }
    if (key.equalsIgnoreCase(target)) return val;
    while (i < challenge.length() && challenge[i] != ',') ++i;
    if (i < challenge.length()) ++i;
  }
  return "";
}

String digestAuthHeader(const String& challenge) {
  if (!challenge.startsWith("Digest ")) return "";
  String realm = digestField(challenge, "realm");
  String nonce = digestField(challenge, "nonce");
  String qop = digestField(challenge, "qop");
  String algorithm = digestField(challenge, "algorithm");
  String opaque = digestField(challenge, "opaque");
  if (realm.isEmpty() || nonce.isEmpty()) return "";
  if (algorithm.length() && !algorithm.equalsIgnoreCase("MD5")) {
    Serial.println("Camera Digest algorithm is not MD5");
    return "";
  }
  // Hikvision typically sends qop=auth. Do not silently use auth-int.
  if (qop.length()) {
    bool hasAuth = false;
    int from = 0;
    while (from < qop.length()) {
      int comma = qop.indexOf(',', from);
      if (comma < 0) comma = qop.length();
      String mode = qop.substring(from, comma);
      mode.trim();
      if (mode.equalsIgnoreCase("auth")) hasAuth = true;
      from = comma + 1;
    }
    if (!hasAuth) {
      Serial.println("Camera Digest qop=auth not offered");
      return "";
    }
  }
  const String uri = "/ISAPI/Streaming/channels/102/picture";
  char nonceCount[] = "00000001";
  char randomHex[17];
  snprintf(randomHex, sizeof(randomHex), "%08lx%08lx",
           (unsigned long)esp_random(), (unsigned long)esp_random());
  String cnonce = randomHex;
  String ha1 = md5Hex(String(CAMERA_USERNAME) + ":" + realm + ":" + CAMERA_PASSWORD);
  String ha2 = md5Hex("GET:" + uri);
  String response = qop.length()
    ? md5Hex(ha1 + ":" + nonce + ":" + nonceCount + ":" + cnonce + ":auth:" + ha2)
    : md5Hex(ha1 + ":" + nonce + ":" + ha2);
  if (response.isEmpty()) return "";
  String header = "Digest username=\"" + String(CAMERA_USERNAME) +
                  "\", realm=\"" + realm + "\", nonce=\"" + nonce +
                  "\", uri=\"" + uri + "\", response=\"" + response + "\"";
  if (qop.length()) header += ", qop=auth, nc=" + String(nonceCount) + ", cnonce=\"" + cnonce + "\"";
  header += ", algorithm=MD5";
  if (opaque.length()) header += ", opaque=\"" + opaque + "\"";
  return header;
}

bool connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return true;
  Serial.println("Connecting to WiFi...");
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000UL) {
    delay(500);
    Serial.print('.');
  }
  Serial.println();
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("WiFi connection timed out");
    return false;
  }
  Serial.print("ESP32 IP: ");
  Serial.println(WiFi.localIP());
  return true;
}

bool firebaseSignIn() {
  Serial.println("Signing in to Firebase...");
  HTTPClient http;
  String url = "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=";
  url += FIREBASE_API_KEY;
  if (!http.begin(secureClient, url)) return false;
  http.setTimeout(15000);
  http.addHeader("Content-Type", "application/json");
  StaticJsonDocument<512> requestDoc;
  requestDoc["email"] = FIREBASE_EMAIL;
  requestDoc["password"] = FIREBASE_PASSWORD;
  requestDoc["returnSecureToken"] = true;
  String body;
  serializeJson(requestDoc, body);
  int status = http.POST(body);
  String response = http.getString();
  http.end();
  if (status != 200) {
    Serial.printf("Firebase login failed: %d\n", status);
    Serial.println(response);
    return false;
  }
  DynamicJsonDocument responseDoc(4096);
  DeserializationError error = deserializeJson(responseDoc, response);
  if (error) {
    Serial.println("Firebase login JSON error");
    return false;
  }
  String newToken = responseDoc["idToken"].as<String>();
  if (newToken.isEmpty()) {
    Serial.println("Firebase ID token missing");
    return false;
  }
  firebaseIdToken = newToken;
  lastAuthTime = millis();
  Serial.println("Firebase login successful");
  return true;
}

bool ensureFirebaseAuth() {
  if (firebaseIdToken.isEmpty() || millis() - lastAuthTime >= AUTH_REFRESH_INTERVAL)
    return firebaseSignIn();
  return true;
}

bool captureCameraImage() {
  Serial.println("Capturing Hikvision image with manual Digest auth...");
  jpegLength = 0;

  // 1) Ask camera for challenge, intentionally unauthenticated.
  // The expected first HTTP response is 401, NOT a fatal error.
  WiFiClient challengeNet;
  HTTPClient challengeHttp;
  if (!challengeHttp.begin(challengeNet, CAMERA_URL)) {
    Serial.println("Camera challenge connection failed");
    return false;
  }
  challengeHttp.setTimeout(15000);
  challengeHttp.setReuse(false);
  const char* keys[] = {"WWW-Authenticate"};
  challengeHttp.collectHeaders(keys, 1);
  int firstStatus = challengeHttp.GET();
  String challenge = challengeHttp.header("WWW-Authenticate");
  challengeHttp.end();

  if (firstStatus != 401) {
    Serial.printf("Expected camera HTTP 401 challenge, got %d\n", firstStatus);
    return false;
  }
  String authorization = digestAuthHeader(challenge);
  if (authorization.isEmpty()) {
    Serial.println("Could not parse camera Digest challenge");
    return false;
  }

  // 2) Replay GET with a computed Digest Authorization header.
  WiFiClient imageNet;
  HTTPClient imageHttp;
  if (!imageHttp.begin(imageNet, CAMERA_URL)) {
    Serial.println("Camera image connection failed");
    return false;
  }
  imageHttp.setTimeout(20000);
  imageHttp.setReuse(false);
  imageHttp.addHeader("Authorization", authorization);
  int status = imageHttp.GET();
  if (status != 200) {
    Serial.printf("Camera authorized GET failed, HTTP %d\n", status);
    imageHttp.end();
    return false;
  }
  int advertisedLength = imageHttp.getSize();
  if (advertisedLength > (int)MAX_JPEG_SIZE) {
    Serial.printf("JPEG too large: %d bytes\n", advertisedLength);
    imageHttp.end();
    return false;
  }

  // 3) HTTPClient::writeToStream handles chunked responses too,
  // writing in small pieces to flash rather than allocating 160 KB RAM.
  SPIFFS.remove(IMAGE_PATH);
  File file = SPIFFS.open(IMAGE_PATH, FILE_WRITE);
  if (!file) {
    Serial.println("SPIFFS image file open failed");
    imageHttp.end();
    return false;
  }
  int written = imageHttp.writeToStream(&file);
  file.close();
  imageHttp.end();

  if (written <= 0 || (size_t)written > MAX_JPEG_SIZE) {
    Serial.printf("JPEG stream failed or oversized, result=%d\n", written);
    SPIFFS.remove(IMAGE_PATH);
    return false;
  }
  jpegLength = (size_t)written;
  File verify = SPIFFS.open(IMAGE_PATH, FILE_READ);
  if (!verify || verify.size() != jpegLength || jpegLength < 4) {
    Serial.println("JPEG file missing or incomplete");
    if (verify) verify.close();
    SPIFFS.remove(IMAGE_PATH);
    return false;
  }
  bool startOK = (verify.read() == 0xFF && verify.read() == 0xD8);
  verify.seek(jpegLength - 2);
  bool endOK = (verify.read() == 0xFF && verify.read() == 0xD9);
  verify.close();
  if (!startOK || !endOK) {
    Serial.println("Invalid JPEG start/end markers");
    SPIFFS.remove(IMAGE_PATH);
    return false;
  }
  Serial.printf("Image captured: %u bytes\n", (unsigned)jpegLength);
  return true;
}

int uploadToStorage() {
  Serial.println("Uploading to Firebase Storage...");
  File imageFile = SPIFFS.open(IMAGE_PATH, "r");
  if (!imageFile) {
    Serial.println("Cannot open JPEG for upload");
    return -1;
  }
  String url = "https://firebasestorage.googleapis.com/v0/b/";
  url += FIREBASE_BUCKET;
  url += "/o?uploadType=media&name=hikcam%2Flatest.jpg";
  HTTPClient http;
  if (!http.begin(secureClient, url)) {
    imageFile.close();
    return -1;
  }
  http.setTimeout(30000);
  http.addHeader("Authorization", "Firebase " + firebaseIdToken);
  http.addHeader("Content-Type", "image/jpeg");
  // Stream the file in small chunks rather than loading it into RAM.
  int status = http.sendRequest("POST", &imageFile, jpegLength);
  String response = http.getString();
  http.end();
  imageFile.close();
  if (status == 200 || status == 201) Serial.println("Image uploaded successfully");
  else {
    Serial.printf("Storage upload failed: %d\n", status);
    Serial.println(response);
  }
  return status;
}

int updateRealtimeDatabase(int storageStatus) {
  Serial.println("Updating Realtime Database...");
  String url = FIREBASE_DATABASE_URL;
  url += "/hikcam/latest_frame.json?auth=";
  url += firebaseIdToken;
  HTTPClient http;
  if (!http.begin(secureClient, url)) return -1;
  http.setTimeout(15000);
  http.addHeader("Content-Type", "application/json");
  StaticJsonDocument<512> doc;
  doc["storagePath"] = "hikcam/latest.jpg";
  doc["bucket"] = FIREBASE_BUCKET;
  doc["contentType"] = "image/jpeg";
  doc["sizeBytes"] = jpegLength;
  doc["storageUploaded"] = (storageStatus == 200 || storageStatus == 201);
  doc["storageHttpStatus"] = storageStatus;
  doc["cameraCaptured"] = true;
  time_t now = time(nullptr);
  if (now > 1700000000) doc["capturedAtUnix"] = (int64_t)now;
  String body;
  serializeJson(doc, body);
  int status = http.PUT(body);
  String response = http.getString();
  http.end();
  if (status == 200) Serial.println("Database updated successfully");
  else {
    Serial.printf("Database update failed: %d\n", status);
    Serial.println(response);
  }
  return status;
}

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("Hikvision ESP32 Firebase System (Storage status + RTDB)");
  // Confirm this firmware's partition table actually includes SPIFFS.
  const esp_partition_t* fsPart = esp_partition_find_first(
    ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_SPIFFS, nullptr);
  if (!fsPart) {
    Serial.println("ERROR: No SPIFFS partition in selected Partition Scheme.");
    Serial.println("Arduino IDE > Tools > Partition Scheme: select a scheme WITH SPIFFS.");
    return;
  }
  Serial.printf("SPIFFS partition size: %u bytes\n", (unsigned)fsPart->size);

  // true = format the SPIFFS partition ONLY if mounting fails.
  // CAUTION: this deletes existing SPIFFS files when formatting is needed.
  spiffsReady = SPIFFS.begin(true);
  if (!spiffsReady) {
    Serial.println("ERROR: SPIFFS mount/format failed.");
    Serial.println("Check flash size, partition scheme and physical flash health.");
    return;
  }
  Serial.printf("SPIFFS mounted: total=%u, used=%u, free=%u bytes\n",
                (unsigned)SPIFFS.totalBytes(),
                (unsigned)SPIFFS.usedBytes(),
                (unsigned)(SPIFFS.totalBytes() - SPIFFS.usedBytes()));
  if (SPIFFS.totalBytes() - SPIFFS.usedBytes() < MAX_JPEG_SIZE + 4096) {
    Serial.println("WARNING: Free SPIFFS space is below the 160 KB JPEG limit.");
    Serial.println("Choose a larger SPIFFS partition or reduce MAX_JPEG_SIZE.");
  }
  if (!connectWiFi()) return;
  // TEST ONLY: TLS verification disabled. Use CA validation in production.
  secureClient.setInsecure();
  configTime(0, 0, "pool.ntp.org", "time.google.com");
  firebaseSignIn();
  Serial.println("System ready");
}

void loop() {
  if (!spiffsReady) {
    Serial.println("SPIFFS unavailable: check startup error above and Tools > Partition Scheme");
    delay(5000);
    return;
  }
  if (!connectWiFi()) { delay(3000); return; }
  if (!ensureFirebaseAuth()) { delay(3000); return; }
  if (millis() - lastCaptureTime >= CAPTURE_INTERVAL) {
    if (captureCameraImage()) {
      int storageStatus = uploadToStorage();
      if (storageStatus == 401 && firebaseSignIn())
        storageStatus = uploadToStorage();
      // Always record the capture in Realtime Database, even when Storage
      // returns an error. The record explicitly says whether upload succeeded.
      // NOTE: Realtime Database stores metadata, not the image bytes.
      int dbStatus = updateRealtimeDatabase(storageStatus);
      if (dbStatus == 401 && firebaseSignIn()) {
        dbStatus = updateRealtimeDatabase(storageStatus);
      }
      if (dbStatus != 200) {
        Serial.printf("Realtime Database metadata write failed: HTTP %d\n", dbStatus);
      }
      SPIFFS.remove(IMAGE_PATH);
    }
    lastCaptureTime = millis();
  }
  delay(50);
}
